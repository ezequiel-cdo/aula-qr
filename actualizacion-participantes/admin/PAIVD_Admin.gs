/** Proyecto ADMINISTRACION privado, sin aplicación web. Copiar también PAIVD_Registro.gs.
 * Mismas propiedades privadas del proyecto participantes + PAIVD_ADMIN_EMAIL.
 * No instalar PAIVD_Participantes.gs aquí.
 */
const PAIVD_CRED_HEAD_=['ID_Matricula','Hash_Codigo','Expira_MS','Estado','Responsable','Fecha_Emision'];
function paivdProp_(k){const v=PropertiesService.getScriptProperties().getProperty(k);if(!v)throw Error('Falta '+k);return v;}
function paivdAdmin_(){const a=Session.getActiveUser().getEmail().toLowerCase();if(!a||a!==paivdProp_('PAIVD_ADMIN_EMAIL').toLowerCase()||a!==Session.getEffectiveUser().getEmail().toLowerCase())throw Error('No autorizado');return a;}
function paivdLibro_(){paivdAdmin_();if(paivdProp_('PAIVD_ENSAYO')!=='SI')throw Error('Solo ensayo');return SpreadsheetApp.openById(paivdProp_('PAIVD_TARGET_ID'));}
function paivdCred_(){paivdAdmin_();return SpreadsheetApp.openById(paivdProp_('PAIVD_CREDENCIALES_ID'));}
function paivdDigest_(s){const secret=paivdProp_('PAIVD_SECRETO');if(!/^[a-f0-9]{64}$/i.test(secret))throw Error('Secreto inválido');return Utilities.computeHmacSha256Signature(s,secret).map(b=>('0'+(b&255).toString(16)).slice(-2)).join('');}
function PAIVD_PrepararCredenciales(){paivdAdmin_();const ss=paivdCred_();if(ss.getId()===paivdLibro_().getId())throw Error('Usar libro auxiliar independiente');let h=ss.getSheetByName('Credenciales');if(!h)h=ss.insertSheet('Credenciales');if(!h.getLastRow()){h.getRange(1,1,1,6).setValues([PAIVD_CRED_HEAD_]);h.getRange('A:F').setNumberFormat('@');}paivdHoja_();console.log('Almacén auxiliar preparado.');}
function paivdHoja_(){const h=paivdCred_().getSheetByName('Credenciales');if(!h||h.getLastColumn()!==6||h.getRange(1,1,1,6).getDisplayValues()[0].some((x,i)=>x!==PAIVD_CRED_HEAD_[i]))throw Error('Esquema de credenciales incompatible');return h;}
function PAIVD_EmitirCredencial(){const responsable=paivdAdmin_(),props=PropertiesService.getScriptProperties();if(props.getProperty('PAIVD_IDENTIDAD_COMPROBADA')!=='SI')throw Error('Confirmación docente requerida');const id=paivdProp_('PAIVD_MATRICULA_EMISION');const r=epjaPublicoRegistroValidado_().filas.find(x=>x.ID_Matricula===id&&x.Curso==='Tercero'&&x.Ano_Escolar==='2026-2027');if(!r)throw Error('Matrícula no disponible para piloto');const l=LockService.getScriptLock();l.waitLock(15000);try{props.deleteProperty('PAIVD_IDENTIDAD_COMPROBADA');props.deleteProperty('PAIVD_MATRICULA_EMISION');const h=paivdHoja_();const rows=h.getLastRow()>1?h.getRange(2,1,h.getLastRow()-1,6).getDisplayValues():[];if(rows.some(x=>x[0]===id&&x[3]==='EMITIDA'&&Number(x[2])>Date.now()))throw Error('Ya existe una credencial vigente; esperar caducidad antes de reemitir');const code=Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');h.appendRow([id,paivdDigest_('codigo:'+code),String(Date.now()+48*3600000),'EMITIDA',responsable,new Date().toISOString()]);SpreadsheetApp.flush();/* Entrega exclusivamente local al titular; registro de ejecución privado. */console.log('Credencial individual (no compartir este registro): '+code);}finally{l.releaseLock();}}
